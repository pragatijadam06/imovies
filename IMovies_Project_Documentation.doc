    <th>Port / URL</th>
  </tr>
  <tr>
    <td><strong>MongoDB</strong></td>
    <td><code>&amp; "C:\Program Files\MongoDB\Server\9.0\bin\mongod.exe" --dbpath C:\data\db</code></td>
